{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alloymc-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Cloudflare D1 database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alloymc-db",
      "database_id": "c70928f2-b167-4a1f-a759-c4d37ccc5666"
    }
  ],

  // Cloudflare R2 bucket for mod images
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "alloymc-images"
    }
  ],

  // Cloudflare KV for session storage
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "aba58bb5f7724aa6a3389d9e9736a395"
    }
  ],

  // Static assets
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Custom domain
  "routes": [
    {
      "pattern": "alloymc.net/*",
      "zone_name": "alloymc.net"
    },
    {
      "pattern": "alloymc.net",
      "zone_name": "alloymc.net"
    }
  ]
}
